# Copy to .env; run `set -a; source .env; set +a` before starting.
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080
DEVICE_ID=demo-device
AGENTAPI_MODE=mock
DEV_TOOLS=true
DATA_DIR=.data/results
# Optional for local mock; required in http mode. Never use AGENTAPI_API_KEY here.
CONTROL_TOKEN=

# Real integration: use a preconfigured claudecode agent and an environment.
AGENTAPI_BASE_URL=
AGENTAPI_API_KEY=
AGENTAPI_AGENT_VERSION=
AGENTAPI_AGENT_ID=
AGENTAPI_ENVIRONMENT_ID=

# Optional comma-separated AgentAPI Vault references; secrets remain upstream.
AGENTAPI_VAULT_IDS=

# Multi-runtime configuration: a JSON object with default_runtime and profiles.
# When set, remove legacy AGENTAPI_AGENT_ID/AGENT_VERSION/ENVIRONMENT_ID/VAULT_IDS.
# See docs/deploy.md#runtime-profiles for the exact schema.
# AGENTAPI_RUNTIME_PROFILES_JSON='{"default_runtime":"codex","profiles":[...]}'
# AGENTAPI_DEFAULT_RUNTIME=codex
